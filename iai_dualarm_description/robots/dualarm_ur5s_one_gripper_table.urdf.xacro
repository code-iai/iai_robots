<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro"
       name="ur5dualarm" >

  <xacro:arg name="transmission_hw_interface" default="hardware_interface/PositionJointInterface"/>

  <material name="gray">
    <color rgba="0.56 0.67 0.67 1"/>
  </material>

  <material name="Silver">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <material name="Grey">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <xacro:property name="table_height" value="0.6077" />
  <xacro:property name="table_length" value="1.19" />
  <!-- left mounting location -->
  <xacro:property name="left_arm_mounting_plate_width" value="0.18" />
  <xacro:property name="left_arm_mounting_plate_length" value="0.15" />
  <xacro:property name="left_arm_mounting_plate_height" value="0.006" />
  <xacro:property name="left_arm_mounting_plate_x_offset" value="0.37" />
  <xacro:property name="left_arm_mounting_plate_y_offset" value="0.22" />
  <xacro:property name="left_kms_mounting_plate_height" value="0.016" />
  <!-- right mounting location -->
  <xacro:property name="right_arm_mounting_plate_width" value="0.18" />
  <xacro:property name="right_arm_mounting_plate_length" value="0.15" />
  <xacro:property name="right_arm_mounting_plate_height" value="0.006" />
  <xacro:property name="right_arm_mounting_plate_x_offset" value="1.07" />
  <xacro:property name="right_arm_mounting_plate_y_offset" value="0.22" />
  <xacro:property name="right_kms_mounting_plate_height" value="0.016" />

  <!-- common stuff -->
  <xacro:include filename="$(find iai_ur_description)/urdf/common.gazebo.xacro" />

  <!-- ur5 -->
  <xacro:include filename="$(find iai_ur_description)/urdf/ur5.urdf.xacro" />

  <!-- arm left -->
  <xacro:arg name="kinematics_config_left" default="$(find iai_ur_description)/config/ur5_default.yaml"/>
  <xacro:ur5_robot prefix="left_" joint_limited="false"
    transmission_hw_interface="$(arg transmission_hw_interface)"
    kinematics_file="${xacro.load_yaml('$(arg kinematics_config_left)')}"
  />
  <!-- arm right -->
  <xacro:arg name="kinematics_config_right" default="$(find iai_ur_description)/config/ur5_default.yaml"/>
  <xacro:ur5_robot prefix="right_" joint_limited="false"
    transmission_hw_interface="$(arg transmission_hw_interface)"
    kinematics_file="${xacro.load_yaml('$(arg kinematics_config_right)')}"
  />

  <link name="map" />

  <joint name="table_joint" type="fixed">
      <parent link="map"/>
      <child link="table"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>

  <link name="table">
    <visual>
      <geometry>
        <mesh filename="package://iai_table_robot_description/meshes/complete_table.dae"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://iai_table_robot_description/meshes/complete_table.stl"/>
      </geometry>
      <material name="gray"/>
    </collision>
  </link>

  <joint name="left_arm_mounting_plate_joint" type="fixed">
    <parent link="table"/>
    <child link="left_arm_mounting_plate"/>
    <origin xyz="${-table_length+left_arm_mounting_plate_x_offset+left_arm_mounting_plate_length/2} ${-left_arm_mounting_plate_y_offset-left_arm_mounting_plate_width/2} ${table_height}"/>
  </joint>

  <link name="left_arm_mounting_plate">
    <visual>
      <geometry>
        <mesh filename="package://iai_table_robot_description/meshes/base_to_optical_table.stl"/>
      </geometry>
      <material name="Silver"/>
    </visual>
  </link>

  <joint name="right_arm_mounting_plate_joint" type="fixed">
    <parent link="table"/>
    <child link="right_arm_mounting_plate"/>
    <origin xyz="${-table_length+right_arm_mounting_plate_x_offset+right_arm_mounting_plate_length/2} ${-right_arm_mounting_plate_y_offset-right_arm_mounting_plate_width/2} ${table_height}"/>
  </joint>

  <link name="right_arm_mounting_plate">
    <visual>
      <geometry>
        <mesh filename="package://iai_table_robot_description/meshes/base_to_optical_table.stl"/>
      </geometry>
      <material name="Silver"/>
    </visual>
  </link>

  <joint name="right_arm_base_mounting_joint" type="fixed">
    <parent link="right_arm_mounting_plate" />
    <child link="right_base_link" />
    <origin xyz="0.0 0.0 ${right_arm_mounting_plate_height}" rpy="0 0 -${pi/4}" />
  </joint>

  <link name="right_kms_mounting_plate">
    <visual>
      <geometry>
        <mesh filename="package://iai_table_robot_description/meshes/adapter_plate_iso50_kms40_weiss.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="right_kms_mounting_plate_joint" type="fixed">
    <parent link="right_ee_link" />
    <child link="right_kms_mounting_plate" />
    <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
  </joint>

  <kms_40_xacro parent="right_kms_mounting_plate" prefix="">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </kms_40_xacro>

  <joint name="left_arm_base_mounting_joint" type="fixed">
    <parent link="left_arm_mounting_plate" />
    <child link="left_base_link" />
    <origin xyz="0.0 0.0 ${left_arm_mounting_plate_height}" rpy="0 0 -${pi/4}" />
  </joint>

  <link name="left_kms_mounting_plate">
    <visual>
      <geometry>
        <mesh filename="package://iai_table_robot_description/meshes/adapter_plate_iso50_kms40_weiss.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="left_kms_mounting_plate_joint" type="fixed">
    <parent link="left_ee_link" />
    <child link="left_kms_mounting_plate" />
    <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
  </joint>

  <kms_40_xacro parent="left_kms_mounting_plate" prefix="">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </kms_40_xacro>

<!--Gripper-->
<xacro:include filename="$(find iai_wsg_50_description)/urdf/wsg_50.urdf.xacro"/>

<link name="left_adapter">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.01"/>
      </geometry>
      <material name="Cyan">
        <color rgba="0 1.0 1.0 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="left_adapter_joint" type="fixed">
    <parent link="left_wrist_3_link"/>
    <child link="left_adapter"/>
    <origin xyz="0 0 0.005" rpy="0.0 0.0 3.14" />
  </joint>

  <xacro:wsg_50_xacro parent="left_adapter" name="left_gripper">
    <origin xyz="0 0 0" rpy="0 0 -0.785"/>
  </xacro:wsg_50_xacro>

</robot>
